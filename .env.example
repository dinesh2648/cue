# ─── Deployment config for docker compose (copy to .env on the VM) ───
# Everything is optional — leave blank for the zero-credential pilot. Fill to go live.

# Public URLs (set to your VM's domain/IP in production; used for OAuth redirects + the
# browser→API URL baked into the frontend at build time).
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000          # what the browser calls (NEXT_PUBLIC_API_URL)
CORS_ORIGINS=http://localhost:3000

# Database — default SQLite (pilot). For production Postgres, run with --profile full:
#   DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot
DATABASE_URL=sqlite:////data/copilot.db

# Host ports to publish (change if something else uses 3000/8000 on the VM)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Launch scope
ENABLED_PACKS=sales

# Real Claude (recommended)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Security (REQUIRED in production)
TOKEN_ENCRYPTION_KEY=

# Auth / SSO (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Connectors (per-provider OAuth apps)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Meeting capture
RECALL_API_KEY=

# Ops
SENTRY_DSN=
