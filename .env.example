# ─── Deployment config for docker compose (copy to .env on the VM) ───
# Everything is optional — leave blank for the zero-credential pilot. Fill to go live.

# Public URLs (set to your VM's domain/IP in production; used for OAuth redirects + the
# browser→API URL baked into the frontend at build time).
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000          # what the browser calls (NEXT_PUBLIC_API_URL)
CORS_ORIGINS=http://localhost:3000

# Database — default SQLite (pilot). For production Postgres, run with --profile full:
#   DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot
DATABASE_URL=sqlite:////data/copilot.db

# Host ports to publish (change if something else uses 3000/8000 on the VM)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Launch scope
ENABLED_PACKS=sales

# Real Claude (recommended)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cost control — cap the live-answer MCP tool surface to read/search tools (default on).
# Leave both blank to use the built-in defaults. Set MCP_TOOL_ALLOWLIST=false to hand the
# model every tool again. OVERRIDES is JSON: a provider REPLACES its built-in list, [] leaves
# it unrestricted, a new provider adds one. Empty/invalid is safe (falls back to defaults).
#   MCP_TOOL_ALLOWLIST_OVERRIDES={"hubspot":["hubspot-search-objects","hubspot-get-object"]}
MCP_TOOL_ALLOWLIST=true
MCP_TOOL_ALLOWLIST_OVERRIDES=

# Prompt caching — cache the stable system(+tools) prefix so repeat calls read it at ~0.1x
# (biggest win on deep answers: re-sent every question in a meeting). Default on; set false to disable.
PROMPT_CACHE=true

# Google Meet recap WITHOUT Recall — pull the official Meet transcript after a call ends and run
# the normal summary/scorecard recap (no bot, no Recall cost; NO live in-call answers). Requires:
# (1) reconnect Google to grant the meetings.space.readonly scope, (2) a Workspace plan with Meet
# transcripts, (3) transcription turned ON for the meeting. Off by default.
MEET_TRANSCRIPT_INGEST=false
MEET_INGEST_LOOKBACK_HOURS=12

# Security (REQUIRED in production)
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=              # signs session JWTs; falls back to TOKEN_ENCRYPTION_KEY

# Auth — Sign in with Google (uses the GOOGLE_CLIENT_* below; unset → DEV mode).
# Register redirect URI {APP_BASE_URL}/api/auth/google/callback on the Google OAuth app.

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Connectors (per-provider OAuth apps). Redirect URI per provider:
#   {APP_BASE_URL}/api/connectors/<provider>/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# GOOGLE_CLIENT_* powers BOTH sign-in and the Drive/Gmail/Calendar connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meeting capture
RECALL_API_KEY=

# Ops
SENTRY_DSN=
