# ─── Copy to .env and fill in to enable real integrations. All optional. ───
# The app runs in DEV mode (single user, seeded mock data, offline answers) with
# none of these set. Add them to light up the real multi-tenant platform.

# URLs — OAuth redirect URIs are built from APP_BASE_URL, so keep it STABLE. For local dev use
# http://localhost:8000 (Google/most providers allow localhost redirect URIs) and register
# {APP_BASE_URL}/api/auth/google/callback + /api/connectors/<provider>/callback once. Do NOT
# point this at an ephemeral tunnel — the hostname changes on every restart and breaks OAuth
# (redirect_uri_mismatch). The Recall webhook uses RECALL_PUBLIC_URL instead (see below).
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Storage — PostgreSQL recommended (psycopg driver is installed). Create the DB
# (createdb cue) then set this; run.sh auto-applies migrations (alembic upgrade head).
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cue
# Zero-config local fallback (no server needed) — self-creates the schema on startup:
# DATABASE_URL=sqlite:///./copilot.db

# ─── Claude (agent runtime) ───────────────────────────────────────────────
# With a key, suggestions are generated by Claude running the agentic loop over
# each employee's connected MCP tools. Without it, the offline composer is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_ENGINE=auto                 # auto | messages_mcp | agent_sdk | offline

# OpenAI is optional (used only for embeddings if you prefer them over local TF-IDF)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ─── Auth (Google sign-in) ────────────────────────────────────────────────
# Unset → DEV mode (single seeded user, no login). Set the two GOOGLE_CLIENT_*
# vars below (in the Connectors section — the same Google OAuth app powers both
# login and the Drive/Gmail/Calendar connectors) to require "Sign in with Google".
# Users are grouped into one workspace by email domain (e.g. everyone @acme.com).
#
# Add this redirect URI to the Google OAuth app's "Authorized redirect URIs":
#   {APP_BASE_URL}/api/auth/google/callback
#
# SESSION_SECRET signs our own session JWTs (any strong random string). Falls back
# to TOKEN_ENCRYPTION_KEY, then an insecure dev key. Set it in production.
SESSION_SECRET=

# ─── Per-user OAuth token encryption (Fernet) ─────────────────────────────
# Any strong secret; a key is derived from it. REQUIRED for production.
TOKEN_ENCRYPTION_KEY=

# ─── Connectors (per-employee OAuth + remote MCP) ─────────────────────────
# Each employee clicks "Connect" and authorizes on the provider's own consent page
# with THEIR account — the copilot only ever reads what they can. Create one OAuth
# app per provider, set client id/secret below, and register the redirect URI:
#   {APP_BASE_URL}/api/connectors/<provider>/callback
# Until creds are set, a connector uses a built-in demo consent screen so the
# click-through UX works with zero setup. MCP URLs default to hosted servers where
# they exist; Google/LinkedIn need a self-hosted or partner MCP for data to flow.

# HubSpot — redirect URI: {APP_BASE_URL}/api/connectors/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# HUBSPOT_MCP_URL=https://mcp.hubspot.com/anthropic   (hosted MCP — data flows out of the box)

# Notion — redirect URI: {APP_BASE_URL}/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# NOTION_MCP_URL=https://mcp.notion.com/mcp           (hosted MCP — data flows out of the box)

# Google — ONE OAuth app powers login + Drive + Gmail + Calendar. Register ALL of:
#   {APP_BASE_URL}/api/auth/google/callback              (sign-in)
#   {APP_BASE_URL}/api/connectors/google_drive/callback
#   {APP_BASE_URL}/api/connectors/gmail/callback
#   {APP_BASE_URL}/api/connectors/google_calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google has no official hosted MCP — point these at self-hosted MCP servers for
# the agent to actually read the data (connecting the account still works without):
# GOOGLE_DRIVE_MCP_URL=
# GMAIL_MCP_URL=
# GOOGLE_CALENDAR_MCP_URL=

# GitHub (Tech copilot) — OAuth app at github.com/settings/developers
# redirect URI: {APP_BASE_URL}/api/connectors/github/callback ; hosted MCP set (api.githubcopilot.com)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Jira / Atlassian (Tech copilot) — one OAuth app powers Jira (+ Confluence)
# redirect URI: {APP_BASE_URL}/api/connectors/jira/callback ; Atlassian remote MCP (SSE) set
# Create at developer.atlassian.com → OAuth 2.0 (3LO); scopes read:jira-work read:jira-user offline_access.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Slack — channels, threads & message search for discussion context (read in-process via the
# Slack Web API — no hosted MCP). SIMPLEST connect: create a Slack app (api.slack.com/apps),
# add User Token Scopes (search:read, channels:history, channels:read, groups:history,
# users:read), install to your workspace, copy the "User OAuth Token" (xoxp-…) and paste it on
# the Connections page (like a Notion PAT). The OAuth button also works if you set these +
# register redirect URI {APP_BASE_URL}/api/connectors/slack/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# LinkedIn — redirect URI: {APP_BASE_URL}/api/connectors/linkedin/callback
# Basic profile via standard OAuth; richer prospect/network data needs a partner/
# provider MCP (e.g. Unipile). Point LINKEDIN_MCP_URL at one to unlock it.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_MCP_URL=

# ─── Real meeting capture (Recall.ai bot) ─────────────────────────────────
# With a key, POST /api/meetings/live sends a bot into a real Meet/Zoom/Teams call;
# it streams transcript to /api/webhooks/recall. Without it, the simulator is used.
RECALL_API_KEY=
RECALL_REGION=us-east-1
# Display name shown to participants when the bot joins a call. A descriptive name helps people
# admit it from the waiting room. Defaults to "AL Copilot — Notetaker".
RECALL_BOT_NAME=AL Copilot — Notetaker
# Public URL Recall calls back on for live transcript (needs to be internet-reachable, e.g. a
# cloudflared tunnel). Kept SEPARATE from APP_BASE_URL so OAuth redirects stay on stable
# localhost. `scripts/bringup.sh` sets this automatically when it starts a tunnel. Falls back
# to APP_BASE_URL if unset.
RECALL_PUBLIC_URL=
# Transcription source: "meeting_captions" (needs Meet captions on) or an ASR provider
# like "assembly_ai_streaming" / "deepgram_streaming" (more reliable real-time).
RECALL_TRANSCRIPT_PROVIDER=meeting_captions
# HMAC secret authenticating the inbound transcript webhook (the bot's URL carries a
# per-meeting token derived from this). Falls back to SESSION_SECRET. Set a dedicated
# strong value in production so the public webhook can't be forged.
RECALL_WEBHOOK_SECRET=
# Solo-test aid ONLY — treats every speaker as the customer so one tester sees
# suggestions. MUST be unset in production (else the rep is mislabeled as the customer).
# RECALL_TREAT_ALL_AS_CUSTOMER=

# ─── Billing (Stripe) ─────────────────────────────────────────────────────
# Free plan works with no keys (dev upgrades apply directly). Set these to charge:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=            # Stripe Price ID for the Pro plan
STRIPE_PRICE_ENTERPRISE=    # Stripe Price ID for Enterprise
# Webhook endpoint to register with Stripe: {APP_BASE_URL}/api/webhooks/stripe

# ─── Ops ──────────────────────────────────────────────────────────────────
SENTRY_DSN=                 # optional error tracking (pip install sentry-sdk)
RATE_LIMIT_PER_MINUTE=240   # per-IP API rate limit

# Vector DB / realtime fan-out (optional, per PRD)
QDRANT_URL=
REDIS_URL=

# SLAs / CORS
RESPONSE_SLA_SECONDS=3.0
# Comma-separated allowed origins. Use explicit origins in production — a wildcard "*"
# forces credentials off (the server refuses to emit credentialed CORS with a wildcard).
CORS_ORIGINS=http://localhost:3000
